# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Company mailboxes (GoDaddy Professional Email) ───────────────────────
# Each company connects its own mailbox. Leave a company blank until its
# mailbox exists; sending and the inbox turn on as soon as it's filled in.
FABRICVTON_MAIL_USER=hello@fabricvton.com
FABRICVTON_MAIL_PASS=
FABRICVTON_MAIL_FROM_NAME=FabricVTON

BEATBAND_MAIL_USER=
BEATBAND_MAIL_PASS=
BEATBAND_MAIL_FROM_NAME=BeatBand

NAARADH_MAIL_USER=
NAARADH_MAIL_PASS=
NAARADH_MAIL_FROM_NAME=Naaradh

# Mail servers (optional). GoDaddy's are the default:
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# IMAP_HOST=imap.secureserver.net
# IMAP_PORT=993
# One company on a different provider? Prefix with its name, e.g.
# BEATBAND_SMTP_HOST=smtp.titan.email and BEATBAND_IMAP_HOST=imap.titan.email

# Most recipients one mailbox may email in 24 hours (default 300). Staying under
# the provider's cap keeps the mailbox from being blocked or sent to spam.
# DAILY_SEND_LIMIT=300
# FABRICVTON_DAILY_SEND_LIMIT=300
