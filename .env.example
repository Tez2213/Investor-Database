# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Company mailboxes (Titan Mail by GoDaddy) ─────────────────────────────
# Each company connects its own mailbox. Leave a company blank until its
# mailbox exists; sending and the inbox turn on as soon as it's filled in.
FABRICVTON_MAIL_USER=hello@fabricvton.com
FABRICVTON_MAIL_PASS=
FABRICVTON_MAIL_FROM_NAME=FabricVTON

BEATBAND_MAIL_USER=
BEATBAND_MAIL_PASS=
BEATBAND_MAIL_FROM_NAME=BeatBand

NAARADH_MAIL_USER=
NAARADH_MAIL_PASS=
NAARADH_MAIL_FROM_NAME=Naaradh

# Mail servers (optional, these are Titan's defaults)
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# IMAP_HOST=imap.titan.email
# IMAP_PORT=993
